APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Salla API Configuration
SALLA_ACCESS_TOKEN=
SALLA_WEBHOOK_SECRET=
SALLA_BASE_URL=https://api.salla.dev/admin/v2
SALLA_CHECKOUT_BASE_URL=https://api.salla.dev/store/v2/checkout
SALLA_STORE_ID=
SALLA_STORE_DOMAIN=
SALLA_SYNC_BATCH_SIZE=50
# High-entropy secret used only by trusted catalog synchronization tools.
SALLA_SYNC_TOKEN=

# Zid API Configuration (primary checkout)
ZID_CLIENT_ID=
ZID_CLIENT_SECRET=
ZID_AUTHORIZATION=
ZID_MANAGER_TOKEN=
ZID_REFRESH_TOKEN=
ZID_STORE_ID=
ZID_BASE_URL=https://api.zid.sa/v1
ZID_OAUTH_URL=https://oauth.zid.sa
ZID_REDIRECT_URI=http://127.0.0.1:8766/oauth/callback
ZID_MOCK=0
ZID_PAYMENT_METHOD_ID=
ZID_SHIPPING_METHOD_ID=
ZID_STORE_DOMAIN=

# VIN Decoder (nhtsa | auto_dev)
VIN_DECODER_PROVIDER=nhtsa
VIN_NHTSA_BASE_URL=https://vpic.nhtsa.dot.gov/api/vehicles
VIN_AUTO_DEV_API_KEY=
VIN_CACHE_TTL_MINUTES=1440

# Storefront contact
STOREFRONT_CONTACT_EMAIL=support@qetaa-aljanoob.sa
STOREFRONT_WHATSAPP_NUMBER=966563156460

# Google Sign-In (OAuth 2.0 Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Optional analytics and advertising measurement.
# Leave every identifier blank until the real account IDs are available.
# Prefer GTM_CONTAINER_ID, or use the direct GA4 / Google Ads fields; do not configure both routes.
GTM_CONTAINER_ID=
GA4_MEASUREMENT_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_CONVERSION_LABEL=
META_PIXEL_ID=

# Google Merchant feed safety gates.
# Keep disabled until the business has approved each policy and product condition.
MERCHANT_FEED_ENABLED=0
# Allowed values after confirmation: new, used, refurbished
MERCHANT_PRODUCT_CONDITION=
MERCHANT_SHIPPING_CONFIRMED=0
MERCHANT_TAX_TREATMENT_CONFIRMED=0
MERCHANT_RETURN_POLICY_CONFIRMED=0

# Server-side purchase confirmation. Leave empty to keep the webhook disabled.
PAYMENT_WEBHOOK_SECRET=

# Persistent database maintenance must be run explicitly after a backup.
RUN_STARTUP_CATALOG_CLEANUP=0
RUN_STARTUP_SALLA_MAPPING_REPAIR=0

# Python storefront security defaults.
PRIVATE_UPLOAD_DIR=/data/private/checkout-verify
ALLOWED_ORIGINS=https://chinapartsksa.com

# WhatsApp notifications for VIN photo orders (configure ONE provider)
WHATSAPP_NOTIFY_TO=966563156460
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_API_VERSION=v21.0
ULTRAMSG_INSTANCE_ID=
ULTRAMSG_TOKEN=
